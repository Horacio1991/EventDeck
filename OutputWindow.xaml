<Window x:Class="EventDeck.OutputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="EventDeck · Salida" Background="Black" WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True" Loaded="Window_Loaded" Closed="Window_Closed">
    <Grid Background="Black" ClipToBounds="True">
        <Image x:Name="OutputSurface" Stretch="Uniform"/>
        <Grid x:Name="OutputWebHost">
            <wv2:WebView2 x:Name="OutputWeb" Visibility="Collapsed" />
        </Grid>
        <Border x:Name="OutputBlackOverlay" Background="Black" Visibility="Collapsed" IsHitTestVisible="False"/>
    </Grid>
</Window>
