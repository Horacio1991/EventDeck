<Window x:Class="EventDeck.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="EventDeck" Width="1440" Height="900" MinWidth="960" MinHeight="560" WindowState="Maximized"
        Background="{StaticResource Bg}" Foreground="{StaticResource TextMain}" FontFamily="Segoe UI" WindowStartupLocation="CenterScreen" Icon="pack://application:,,,/Assets/EventDeck.ico" PreviewMouseDown="MainWindow_PreviewMouseDown" PreviewKeyDown="MainWindow_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="LoopTransportToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="IsThreeState" Value="False"/>
            <Setter Property="Background" Value="#202735"/>
            <Setter Property="BorderBrush" Value="#354052"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="LoopBorder" CornerRadius="5" BorderThickness="1"
                                Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}">
                            <Path Width="18" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Stroke="{TemplateBinding Foreground}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Data="M 3,9 L 3,7 C 3,4 5,3 8,3 L 19,3 M 15,0 L 19,3 L 15,6 M 21,9 L 21,11 C 21,14 19,15 16,15 L 5,15 M 9,12 L 5,15 L 9,18"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="{StaticResource AccentSecondary}"/>
                                <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                                <Setter TargetName="LoopBorder" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="LoopBorder" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="LoopBorder" Property="BorderBrush" Value="White"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="LoopBorder" Property="Opacity" Value="0.8"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="LoopBorder" Property="Opacity" Value="0.4"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MusicButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
            <Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></Style.Triggers>
        </Style>
        <Style x:Key="MusicPlayPause" TargetType="Button" BasedOn="{StaticResource MusicButton}">
            <Setter Property="Content" Value="▶ PLAY"/>
            <Style.Triggers><DataTrigger Binding="{Binding StateText}" Value="REPRODUCIENDO"><Setter Property="Content" Value="Ⅱ PAUSA"/></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="WorkspaceTab" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="Background" Value="{StaticResource Panel}"/>
            <Setter Property="Padding" Value="24,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
                <Border Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
            </ControlTemplate></Setter.Value></Setter>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True"><Setter Property="Background" Value="{StaticResource AccentSecondary}"/><Setter Property="Foreground" Value="White"/></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Foreground" Value="{StaticResource Accent}"/></Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,6" LastChildFill="True">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                <Border Width="34" Height="34" CornerRadius="10" Background="{StaticResource AccentSecondary}" Margin="0,0,9,0"><Image Source="pack://application:,,,/Assets/EventDeck-Icon-64.png" Width="30" Height="30" Stretch="Uniform"/></Border>
                <StackPanel><TextBlock Text="EVENTDECK" FontSize="18" FontWeight="Bold"/><TextBlock x:Name="ProjectNameText" Text="Evento sin guardar" Foreground="{StaticResource TextMuted}" FontSize="11"/><TextBlock x:Name="EventHealthText" Text="✓ EVENTO LISTO" Foreground="LightGreen" FontSize="9" FontWeight="SemiBold" ToolTip="No se detectan archivos locales faltantes."/></StackPanel>
            </StackPanel>
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock x:Name="OutputStatusText" Text="SALIDA INACTIVA" FontWeight="Bold" FontSize="12" HorizontalAlignment="Right" Margin="0,0,0,4"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <ComboBox x:Name="ScreenCombo" Width="210" Margin="0,0,8,0" SelectionChanged="ScreenCombo_SelectionChanged">
                    <ComboBox.ItemTemplate>
                        <DataTemplate><TextBlock Text="{Binding Label}"/></DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Content="ACTUALIZAR PANTALLAS" Click="DetectScreens_Click" Margin="0,0,6,0" Padding="10,7"/>
                <Button x:Name="OutputButton" Content="Abrir salida" Click="Output_Click" Background="{StaticResource AccentSecondary}" BorderBrush="{StaticResource Accent}" Padding="11,7"/>
                <Button Content="Abrir evento" Click="OpenProject_Click" Margin="6,0,0,0" Padding="10,7"/>
                <Button Content="Guardar" Click="SaveProject_Click" Margin="6,0,0,0" Padding="10,7"/>
            </StackPanel>
                <TextBlock x:Name="SelectedScreenText" Foreground="{StaticResource TextMuted}" FontSize="10" HorizontalAlignment="Right" Margin="0,4,0,0"/>
            </StackPanel>
        </DockPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4,0,10">
            <RadioButton x:Name="OperationTab" Content="OPERACIÓN" GroupName="Workspace" Tag="Operation" IsChecked="True" Style="{StaticResource WorkspaceTab}" Click="Workspace_Click"/>
            <RadioButton x:Name="MusicTab" Content="MÚSICA" GroupName="Workspace" Tag="Music" Style="{StaticResource WorkspaceTab}" Click="Workspace_Click" Margin="6,0,0,0"/>
        </StackPanel>
        <Grid x:Name="WorkspaceHost" Grid.Row="2" SizeChanged="WorkspaceHost_SizeChanged">
            <ScrollViewer x:Name="OperationViewport" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" ScrollChanged="OperationViewport_ScrollChanged">
                <Grid x:Name="OperationView" MinHeight="520" Height="{Binding ActualHeight, ElementName=WorkspaceHost}">
                    <Grid.RowDefinitions><RowDefinition Height="2*" MinHeight="220"/><RowDefinition Height="0.9*" MinHeight="130"/><RowDefinition Height="2.1*" MinHeight="150"/></Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,6">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{StaticResource Panel}" CornerRadius="12" Padding="8" Margin="0,0,5,0">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <DockPanel Margin="2,0,2,4"><TextBlock Text="PREVIEW" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Accent}"/><TextBlock x:Name="PreviewTitle" Text="Seleccioná un recurso" Foreground="{StaticResource TextMuted}" DockPanel.Dock="Right" TextTrimming="CharacterEllipsis"/></DockPanel>
                    <Border Grid.Row="1" Background="#07090D" CornerRadius="8" ClipToBounds="True">
                        <Grid x:Name="PreviewHost">
                            <TextBlock x:Name="PreviewHint" Text="Elegí una imagen, video o página web de la biblioteca" Foreground="#778292" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Margin="20" TextAlignment="Center"/>
                            <Image x:Name="PreviewImage" Stretch="Uniform" Visibility="Collapsed"/>
                            <Image x:Name="PreviewVideo" Stretch="Uniform" Visibility="Collapsed"/>
                            <Border x:Name="PreviewAudioCard" Visibility="Collapsed" IsHitTestVisible="False">
                                <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="4">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="♫" FontSize="64" FontWeight="Light" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" />
                                    <TextBlock Text="VISTA PREVIA DE AUDIO" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" Margin="0,4,0,7" />
                                    <TextBlock x:Name="PreviewAudioName" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextMain}" TextTrimming="CharacterEllipsis" TextAlignment="Center" MaxWidth="420" />
                                </StackPanel>
                                </Viewbox>
                            </Border>
                            <wv2:WebView2 x:Name="PreviewWeb" Visibility="Collapsed"/>
                            <Image x:Name="PreviewCapture" Stretch="Uniform" Visibility="Collapsed" IsHitTestVisible="False"/>
                            <TextBlock x:Name="CaptureState" Visibility="Collapsed" VerticalAlignment="Bottom" Background="#CC111720" Foreground="White" Padding="6" TextWrapping="Wrap" IsHitTestVisible="False"/>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="2" Margin="0,4,0,0">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Grid.Column="0">
                                <Button x:Name="PreviewPlayButton" Content="▶" ToolTip="Reproducir preview" Click="PreviewPlay_Click" Padding="10,6" Margin="0,0,4,0"/>
                                <Button x:Name="PreviewPauseButton" Content="Ⅱ" ToolTip="Pausar preview" Click="PreviewPause_Click" Padding="10,6" Margin="0,0,4,0"/>
                                <Button x:Name="PreviewStopButton" Content="■" ToolTip="Detener preview" Click="PreviewStop_Click" Padding="10,6"/>
                                <ToggleButton x:Name="PreviewLoop" Style="{StaticResource LoopTransportToggle}" ToolTip="Repetir video (F7)" AutomationProperties.Name="Repetir video" Click="PreviewLoop_Click" VerticalAlignment="Center" Margin="8,0,0,0" IsEnabled="False"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="CUT" Click="Cut_Click" Width="68" Margin="4,0" Background="#263442" Padding="9,6"/>
                                <Button Content="FADE" Click="Fade_Click" Width="68" Background="{StaticResource AccentSecondary}" BorderBrush="{StaticResource Accent}" Padding="9,6"/>
                                <Button Content="MERGE" Click="Merge_Click" Width="72" Background="#35405B" Padding="9,6"/>
                            </StackPanel>
                        </Grid>
                        <Grid Grid.Row="1" Margin="0,3,0,2">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Button x:Name="PreviewMuteButton" Grid.Column="0" Content="🔇 AUDIO PREVIEW" Click="PreviewMute_Click" Padding="7,6" Margin="0,0,4,0" FontSize="10"/>
                            <Button x:Name="ProgramMuteButton" ToolTip="Salida con audio (F6)" Grid.Column="1" Content="🔊 SALIDA CON AUDIO" Click="ProgramMute_Click" Padding="7,6" Margin="4,0,0,0" FontSize="10" IsEnabled="False"/>
                            <Grid Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock x:Name="PreviewCurrent" Text="00:00" Foreground="{StaticResource TextMuted}" FontSize="10" VerticalAlignment="Center"/>
                            <Slider x:Name="PreviewSeek" Grid.Column="1" Minimum="0" Maximum="1" ValueChanged="PreviewSeek_ValueChanged" PreviewMouseLeftButtonUp="PreviewSeek_MouseUp" Margin="8,0" Height="18"/>
                            <TextBlock x:Name="PreviewDuration" Grid.Column="2" Text="00:00" Foreground="{StaticResource TextMuted}" FontSize="10" VerticalAlignment="Center"/>
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
            <Border Grid.Column="1" Background="{StaticResource Panel}" CornerRadius="12" Padding="8" Margin="5,0,0,0">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <DockPanel Margin="2,0,2,4"><TextBlock Text="PROGRAM  /  EN PANTALLA" FontSize="12" FontWeight="Bold"/><TextBlock x:Name="ProgramState" Text="NEGRO" Foreground="{StaticResource TextMuted}" DockPanel.Dock="Right" TextTrimming="CharacterEllipsis"/></DockPanel>
                    <Border x:Name="ProgramMonitorFrame" Grid.Row="1" Background="#050609" CornerRadius="8" ClipToBounds="True">
                        <Grid><Image x:Name="ProgramImage" Stretch="Uniform" Visibility="Collapsed"/><StackPanel x:Name="ProgramPlaceholder" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="EVENTDECK" FontSize="25" FontWeight="Bold" Foreground="#27303C" HorizontalAlignment="Center"/><TextBlock Text="La salida pública comienza en negro" Foreground="#667181" Margin="0,7,0,0"/></StackPanel></Grid>
                    </Border>
                    <Grid Grid.Row="2" Margin="0,6,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><Button x:Name="ProgramPlayButton" Content="▶" ToolTip="Reproducir Program" Click="ProgramPlay_Click" Padding="9,5" Margin="0,0,4,0"/><Button x:Name="ProgramPauseButton" Content="Ⅱ" ToolTip="Pausar Program" Click="ProgramPause_Click" Padding="9,5" Margin="0,0,4,0"/><Button x:Name="ProgramStopButton" Content="■" ToolTip="Detener Program" Click="ProgramStop_Click" Padding="9,5"/></StackPanel><TextBlock x:Name="ProgramPosition" Grid.Column="1" Text="00:00 / 00:00" Foreground="{StaticResource TextMuted}" FontSize="10" VerticalAlignment="Center" Margin="8,0"/><StackPanel Grid.Column="2" Orientation="Horizontal"><Button x:Name="BlackButton" ToolTip="Cubre/descubre la salida sin detener Program ni audio" Content="BLACK · OFF" Click="Black_Click" Background="#562A32" BorderBrush="#8D3C48" Padding="8,5"/></StackPanel><Slider x:Name="ProgramSeek" Grid.Row="1" Grid.ColumnSpan="3" Minimum="0" Maximum="1" ValueChanged="ProgramSeek_ValueChanged" PreviewMouseLeftButtonUp="ProgramSeek_MouseUp" Margin="0,2,0,0" Height="16"/></Grid>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="1" Background="{StaticResource Panel}" CornerRadius="12" Padding="8" Margin="0,0,0,6">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.7*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                <Grid Grid.Column="0" Margin="0,0,8,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <DockPanel Margin="2,0,2,6"><TextBlock Text="SONANDO" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center"><Border Background="#202735" CornerRadius="5" Padding="7,4" Margin="0,0,8,0"><TextBlock x:Name="PlayingCount" Text="0 pistas" Foreground="{StaticResource TextMuted}" FontSize="10" VerticalAlignment="Center"/></Border><Button x:Name="FadeOutAudioButton" Content="FADE OUT" Click="FadeOutAudioButton_Click" Padding="8,4" FontSize="9" Background="#3A3030" BorderBrush="#70504B" ToolTip="Fundir y detener todo el audio de EventDeck"/><TextBlock Text="TECLA" Foreground="{StaticResource TextMuted}" FontSize="9" VerticalAlignment="Center" Margin="8,0,4,0"/><ComboBox x:Name="FadeOutHotkeyCombo" Width="58" SelectedValuePath="Content" SelectionChanged="FadeOutHotkeyCombo_SelectionChanged" VerticalAlignment="Center"><ComboBoxItem Content="F8"/><ComboBoxItem Content="F10"/><ComboBoxItem Content="F11"/><ComboBoxItem Content="F12"/></ComboBox><Button Content="LIMPIAR LISTA" Click="ClearAudioList_Click" Padding="8,4" FontSize="9" Margin="8,0,0,0"/></StackPanel></DockPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="AudioPlayingList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#111720" CornerRadius="8" Padding="7" Margin="0,0,0,5">
                                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                            <DockPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><Border DockPanel.Dock="Right" Background="#202735" CornerRadius="4" Padding="6,3" Margin="8,0,0,0"><TextBlock Text="{Binding StateText}" Foreground="{StaticResource Accent}" FontSize="9"/></Border></DockPanel>
                                            <Slider Grid.Row="1" Minimum="0" Maximum="{Binding DurationSeconds}" Value="{Binding CurrentSeconds, Mode=TwoWay}" Tag="{Binding}" ValueChanged="AudioTrackSeek_ValueChanged" IsMoveToPointEnabled="True" Height="15" Margin="0,0,0,2"/>
                                            <DockPanel Grid.Row="2">
                                                <StackPanel Orientation="Horizontal"><Button Content="Ⅱ / ▶" Click="AudioTrackToggle_Click" Padding="7,3" Margin="0,0,4,0" FontSize="10"/><Button Content="■" ToolTip="Detener" Click="AudioTrackStop_Click" Padding="7,3" FontSize="10" Margin="0,0,4,0"/><Button Content="✕" ToolTip="Quitar canción de la lista" Click="RemoveAudioTrack_Click" Padding="7,3" FontSize="10"/><TextBlock Text="{Binding TimeLabel}" Foreground="{StaticResource TextMuted}" FontSize="9" VerticalAlignment="Center" Margin="7,0,0,0"/></StackPanel>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><TextBlock Text="VOL" Foreground="{StaticResource TextMuted}" FontSize="9" VerticalAlignment="Center"/><Slider Width="75" Minimum="0" Maximum="1" Value="{Binding Volume, Mode=TwoWay}" Tag="{Binding}" ValueChanged="AudioTrackVolume_ValueChanged" Margin="5,0"/></StackPanel>
                                            </DockPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
                <Border Grid.Column="1" Background="#111720" CornerRadius="9" Padding="8">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="PREPARADO / SIGUIENTE" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/><TextBlock Text="·" Foreground="{StaticResource TextMuted}" Margin="7,0" VerticalAlignment="Center"/><TextBlock x:Name="PreparedAudioState" Text="SIN PISTA" Foreground="{StaticResource TextMuted}" FontSize="9" VerticalAlignment="Center"/></StackPanel>
                        <StackPanel Grid.Row="1" VerticalAlignment="Center">
                            <TextBlock x:Name="PreparedAudioTitle" Text="Elegí una canción en la biblioteca" TextTrimming="CharacterEllipsis" Margin="0,0,0,5"/>
                            <TextBlock x:Name="PreparedAudioDuration" Text="Duración: --:--" Foreground="{StaticResource TextMuted}" FontSize="9"/>
                        </StackPanel>
                        <DockPanel Grid.Row="2" Margin="0,4,0,0">
                            <StackPanel Orientation="Horizontal"><Button x:Name="PlayPreparedButton" Content="▶  PLAY" Click="PlayPreparedAudio_Click" Background="{StaticResource AccentSecondary}" BorderBrush="{StaticResource Accent}" Padding="12,6" IsEnabled="False"/><Button x:Name="RemovePreparedButton" Content="✕" ToolTip="Quitar pista preparada" Click="RemovePreparedAudio_Click" Padding="8,6" Margin="4,0,0,0" IsEnabled="False"/></StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><TextBlock Text="VOL" Foreground="{StaticResource TextMuted}" FontSize="9" VerticalAlignment="Center"/><Slider x:Name="PreparedAudioVolume" Width="90" Minimum="0" Maximum="1" Value="0.8" Margin="6,0" ValueChanged="PreparedAudioVolume_ValueChanged"/></StackPanel>
                        </DockPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="{StaticResource Panel}" CornerRadius="12" Padding="8">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="RECURSOS" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" x:Name="ItemCount" Text="  0 recursos" Foreground="{StaticResource TextMuted}" Margin="6,0,8,0" VerticalAlignment="Center" FontSize="10"/>
                    <ScrollViewer Grid.Column="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" CanContentScroll="False">
                        <ListBox x:Name="BinTabs" SelectionChanged="BinTabs_SelectionChanged" DisplayMemberPath="Name" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextMain}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                            <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="MinWidth" Value="100"/><Setter Property="Padding" Value="9,5"/><Setter Property="Margin" Value="2,0"/><Setter Property="Background" Value="#202A36"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="TabBorder" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="TabBorder" Property="Background" Value="{StaticResource AccentSecondary}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
                        </ListBox>
                    </ScrollViewer>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="4,0,3,0">
                        <Button Content="＋ Pestaña" Click="NewBin_Click" Padding="7,5" Margin="0,0,3,0" ToolTip="Crear pestaña"/>
                        <Button Content="✎" Click="RenameBin_Click" Padding="7,5" Margin="0,0,3,0" ToolTip="Renombrar pestaña"/>
                        <Button Content="🗑" Click="DeleteBin_Click" Padding="7,5" ToolTip="Eliminar pestaña"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="4,0,0,0">
                        <TextBox x:Name="ResourceSearchBox" Width="120" Height="30" VerticalContentAlignment="Center" Padding="7,3" Margin="0,0,4,0" ToolTip="Buscar recursos por nombre" TextChanged="ResourceSearch_TextChanged"/>
                        <ComboBox x:Name="ResourceKindFilter" Width="80" Height="30" SelectedValuePath="Tag" SelectionChanged="ResourceFilter_SelectionChanged" ToolTip="Filtrar recursos por tipo">
                            <ComboBoxItem Content="TODOS" Tag="ALL" IsSelected="True"/><ComboBoxItem Content="IMAGEN" Tag="IMAGE"/><ComboBoxItem Content="VIDEO" Tag="VIDEO"/><ComboBoxItem Content="AUDIO" Tag="AUDIO"/><ComboBoxItem Content="CAPTURA" Tag="CAPTURE"/><ComboBoxItem Content="WEB" Tag="WEB"/>
                        </ComboBox>
                        <Button x:Name="RelinkResourceButton" Content="Revincular" Click="RelinkResource_Click" Padding="7,5" Margin="0,0,3,0" IsEnabled="False" ToolTip="Revincular el archivo faltante seleccionado"/>
                        <Button Content="＋ Archivos" Click="AddFiles_Click" Padding="7,5" Margin="0,0,3,0"/>
                        <Button Content="▣ Captura" Click="AddWindowCapture_Click" Padding="7,5" Margin="0,0,3,0" ToolTip="Agregar captura de ventana"/>
                        <Button Content="Eliminar" Click="Remove_Click" Padding="7,5"/>
                    </StackPanel>
                </Grid>
                <ListBox x:Name="LibraryList" Grid.Row="1" Background="#111720" BorderThickness="0" Foreground="{StaticResource TextMain}" FontSize="12" Padding="4" SelectionChanged="LibraryList_SelectionChanged" PreviewKeyDown="LibraryList_PreviewKeyDown" AllowDrop="True" PreviewMouseDoubleClick="LibraryList_DoubleClick" PreviewMouseLeftButtonDown="ResourceList_PreviewMouseLeftButtonDown" PreviewMouseMove="ResourceList_PreviewMouseMove" DragOver="LibraryList_DragOver" Drop="LibraryList_Drop">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid MinHeight="22">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock x:Name="ResourceGlyph" Grid.Column="0" Text="{Binding Glyph}" Foreground="{StaticResource TextMain}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="ResourceLabel" Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="ResourceTypeSeparator" Grid.Column="2" Text="·" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="10,0,5,0"/>
                                <TextBlock x:Name="ResourceType" Grid.Column="3" Text="{Binding TypeLabel}" Foreground="{StaticResource TextMuted}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <StackPanel x:Name="MissingBadge" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,0,0" Visibility="Collapsed">
                                    <TextBlock Text="⚠ " Foreground="#F2B45C" FontWeight="Bold"/>
                                    <TextBlock Text="ARCHIVO NO ENCONTRADO" Foreground="#F2B45C" FontSize="10" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsMissing}" Value="True"><Setter TargetName="MissingBadge" Property="Visibility" Value="Visible"/><Setter TargetName="ResourceLabel" Property="Foreground" Value="#F2B45C"/></DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="8,6"/><Setter Property="Margin" Value="2"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#202A36"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSecondary}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
                </ListBox>
            </Grid>
        </Border>
        <StackPanel x:Name="AudioPlayersHost" Width="1" Height="1" Visibility="Hidden" Opacity="0" IsHitTestVisible="False" Focusable="False"/>
                </Grid>
            </ScrollViewer>
            <ScrollViewer x:Name="MusicViewport" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid MinHeight="470" Height="{Binding ActualHeight, ElementName=WorkspaceHost}">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <DockPanel Margin="4,0,4,12"><TextBlock Text="MÚSICA" FontSize="22" FontWeight="Bold"/><TextBlock x:Name="MusicActiveCount" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}"/></DockPanel>
                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Background="{StaticResource Panel}" CornerRadius="12" Padding="18" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="PREPARADA" Foreground="{StaticResource Accent}" FontWeight="Bold" Margin="0,0,0,10"/>
                                <TextBlock Text="{Binding Text, ElementName=PreparedAudioTitle}" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Text, ElementName=PreparedAudioState}" Foreground="{StaticResource Accent}" Margin="0,4,0,8"/>
                                <TextBlock Text="{Binding Text, ElementName=PreparedAudioDuration}" Foreground="{StaticResource TextMuted}" Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="▶ LANZAR" Click="PlayPreparedAudio_Click" IsEnabled="{Binding IsEnabled, ElementName=PlayPreparedButton}" Style="{StaticResource MusicButton}" Background="{StaticResource AccentSecondary}" Padding="12,6"/>
                                    <Button Content="QUITAR" Click="RemovePreparedAudio_Click" IsEnabled="{Binding IsEnabled, ElementName=RemovePreparedButton}" Style="{StaticResource MusicButton}" Margin="6,0" Padding="12,6"/>
                                    <TextBlock Text="VOL." VerticalAlignment="Center" Margin="6,0"/>
                                    <Slider Width="90" Minimum="0" Maximum="1" Value="{Binding Value, ElementName=PreparedAudioVolume, Mode=TwoWay}" VerticalAlignment="Center" AutomationProperties.Name="Volumen de pista preparada"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button x:Name="MusicFadeOut" Content="FADE OUT" Click="FadeOutAudioButton_Click" Style="{StaticResource MusicButton}" IsEnabled="False" ToolTip="{Binding ToolTip, ElementName=FadeOutAudioButton}" Padding="12,6"/>
                                    <Button x:Name="MusicPreviousPlaceholder" Content="|◀" IsEnabled="False" Style="{StaticResource MusicButton}" ToolTip="Anterior · próximo hito" Padding="10,6" Margin="6,0,0,0"/>
                                    <Button x:Name="MusicNextPlaceholder" Content="▶|" IsEnabled="False" Style="{StaticResource MusicButton}" ToolTip="Siguiente · próximo hito" Padding="10,6" Margin="6,0,0,0"/>
                                    <Button x:Name="MusicLoopPlaceholder" Content="LOOP" IsEnabled="False" Style="{StaticResource MusicButton}" ToolTip="Loop musical no disponible. F7 sigue controlando el video." Padding="10,6" Margin="6,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Background="{StaticResource Panel}" CornerRadius="12" Padding="18" Margin="6,0,0,0">
                            <StackPanel><TextBlock Text="SONANDO · ÚLTIMA PISTA LANZADA" Foreground="{StaticResource Accent}" FontWeight="Bold" Margin="0,0,0,10"/>
<StackPanel x:Name="MusicNowPanel" IsEnabled="False">
    <TextBlock Text="{Binding Name, TargetNullValue=Sin pista activa}" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
    <TextBlock Text="{Binding StateText, TargetNullValue=SIN PISTA}" Foreground="{StaticResource Accent}" Margin="0,4,0,0"/>
    <Grid Margin="0,8,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Slider Minimum="0" Maximum="{Binding DurationSeconds}" Value="{Binding CurrentSeconds, Mode=OneWay}" Tag="{Binding}" ValueChanged="AudioTrackSeek_ValueChanged" IsMoveToPointEnabled="True" AutomationProperties.Name="Posición musical" Margin="0,0,12,0"/>
        <TextBlock Grid.Column="1" Text="{Binding TimeLabel, TargetNullValue='00:00 / 00:00'}" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}"/>
    </Grid>
    <StackPanel Orientation="Horizontal">
        <Button Style="{StaticResource MusicPlayPause}" Click="AudioTrackToggle_Click" Padding="12,6"/>
        <Button Style="{StaticResource MusicButton}" Content="■ STOP" Click="AudioTrackStop_Click" ToolTip="Detener y quitar la pista activa, como en OPERACIÓN" Margin="6,0" Padding="12,6"/>
        <TextBlock Text="VOLUMEN" FontSize="10" VerticalAlignment="Center" Margin="8,0"/>
        <Slider Width="110" Minimum="0" Maximum="1" Value="{Binding Volume, Mode=OneWay}" Tag="{Binding}" ValueChanged="AudioTrackVolume_ValueChanged" VerticalAlignment="Center" AutomationProperties.Name="Volumen musical"/>
    </StackPanel>
</StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Border Grid.Row="2" Background="{StaticResource Panel}" CornerRadius="12" Padding="18">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <WrapPanel Margin="0,0,0,14">
                                <TextBlock Text="Buscar música" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBox x:Name="MusicSearchBox" Width="260" Margin="0,0,10,0" TextChanged="MusicSearch_TextChanged" ToolTip="Buscar música por título o nombre de archivo" AutomationProperties.Name="Buscar música"/>
                                <Button x:Name="MusicAddButton" ToolTip="Biblioteca temporal durante esta ejecución; no se guarda con el evento" Content="+ AGREGAR MÚSICA" Click="MusicAdd_Click" Style="{StaticResource MusicButton}" Margin="0,0,12,0"/>
                                <CheckBox x:Name="MusicAutoPlaceholder" Content="REPRODUCCIÓN AUTOMÁTICA" IsEnabled="False" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" ToolTipService.ShowOnDisabled="True" ToolTip="Disponible en un próximo hito"/>
                            </WrapPanel>
                            <Grid Grid.Row="1" Background="{StaticResource Panel2}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions><TextBlock Text="TÍTULO" Margin="12,8" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="DURACIÓN" Margin="8" FontWeight="SemiBold"/></Grid>
                            <Grid Grid.Row="2">
                                <ListBox x:Name="MusicLibraryList" IsSynchronizedWithCurrentItem="False" Background="#111720" Foreground="{StaticResource TextMain}" BorderThickness="0" SelectionChanged="MusicLibrary_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                                    <ListBox.ItemTemplate><DataTemplate>
                                        <Grid Margin="8,5"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Source}" Margin="0,0,12,0"/>
                                            <TextBlock Grid.Column="1" Text="{Binding DurationLabel}" ToolTip="{Binding DurationStatus}" Foreground="{StaticResource TextMuted}"/>
                                        </Grid>
                                    </DataTemplate></ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock x:Name="MusicLibraryHint" Text="Agregá archivos de audio para preparar tu música. Biblioteca temporal: no se guarda con el evento." Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20" IsHitTestVisible="False"/>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
