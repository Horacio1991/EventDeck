<Window x:Class="EventDeck.WindowPickerDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Captura de ventana" Width="760" Height="450" MinWidth="500" MinHeight="300"
 WindowStartupLocation="CenterOwner" Background="{StaticResource Bg}" Foreground="{StaticResource TextMain}">
 <Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <TextBlock Text="Elegí una ventana abierta y no minimizada. Captura visual en vivo, sin audio. Chrome debe estar configurado manualmente." TextWrapping="Wrap" Margin="0,0,0,12"/>
 <ListBox x:Name="WindowsList" Grid.Row="1" DisplayMemberPath="Label" Background="#111720" Foreground="{StaticResource TextMain}"/>
 <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
 <Button Content="Actualizar ventanas" Click="Refresh_Click" Margin="0,0,8,0"/>
 <Button Content="Cancelar" IsCancel="True" Margin="0,0,8,0"/>
 <Button Content="Agregar captura" Click="Accept_Click" IsDefault="True"/>
 </StackPanel></Grid>
</Window>
